<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ItsycalForWindows.Flyout.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Border
            x:Name="Card"
            Margin="8"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="12">
            <Grid Padding="14,10,14,12" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Month header -->
                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="MonthTitle"
                        VerticalAlignment="Center"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Text="November 2026" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button
                            x:Name="PreviousMonthButton"
                            Width="26"
                            Height="26"
                            Padding="0"
                            AutomationProperties.Name="Previous month"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="&#xE76B;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11" />
                        <Button
                            x:Name="TodayButton"
                            Height="26"
                            Padding="8,0"
                            AutomationProperties.Name="Today"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="Today"
                            FontSize="11" />
                        <Button
                            x:Name="NextMonthButton"
                            Width="26"
                            Height="26"
                            Padding="0"
                            AutomationProperties.Name="Next month"
                            Background="Transparent"
                            BorderThickness="0"
                            Content="&#xE76C;"
                            FontFamily="Segoe MDL2 Assets"
                            FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Weekday header -->
                <Grid x:Name="WeekdayHeader" Grid.Row="1" Margin="0,2,0,0" />

                <!-- Month day cells -->
                <Grid x:Name="DayGrid" Grid.Row="2" RowSpacing="1" ColumnSpacing="1" />

                <!-- Selected day agenda -->
                <Grid Grid.Row="3" RowSpacing="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,2,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="AgendaHeader"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Text="Today" />
                        <TextBlock
                            x:Name="AgendaDate"
                            Grid.Column="1"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            FontSize="12"
                            Text="Nov 8" />
                    </Grid>
                    <ScrollViewer
                        x:Name="AgendaScroll"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Auto">
                        <StackPanel x:Name="AgendaPanel" Spacing="2" />
                    </ScrollViewer>
                    <Border
                        x:Name="DetailsPanel"
                        Grid.Row="2"
                        Padding="10"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <StackPanel Spacing="4">
                            <TextBlock
                                x:Name="DetailsWhen"
                                FontSize="12"
                                FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="DetailsLocation"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontSize="12" />
                            <TextBlock
                                x:Name="DetailsNotes"
                                MaxLines="3"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                FontSize="12" />
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button
                                    x:Name="JoinButton"
                                    Padding="10,3"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    Foreground="White"
                                    FontSize="12">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE714;" FontSize="12" />
                                        <TextBlock Text="Join" FontSize="12" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="CopyButton"
                                    Padding="10,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Content="Copy link" />
                                <Button
                                    x:Name="CloseDetailsButton"
                                    Padding="10,3"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontSize="12"
                                    Content="Close" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
