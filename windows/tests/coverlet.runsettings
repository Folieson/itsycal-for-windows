<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- Only the extension, the shared Core assembly and the provider framework count; the
               test assembly would otherwise inflate the number with its own lines. -->
          <Format>cobertura</Format>
          <Include>[ItsycalForWindows]*,[ItsycalForWindows.Core]*,[ItsycalForWindows.Providers]*</Include>
          <ExcludeByAttribute>GeneratedCodeAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
